# MongoDB. An mongodb+srv URI is fine: if querySrv DNS fails, the app retries
# through DNS-over-HTTPS and a standard seed-list URI.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.net/?retryWrites=true&w=majority
# MONGODB_URI=mongodb://USER:PASSWORD@ac-example-shard-00-00.example.mongodb.net:27017,ac-example-shard-00-01.example.mongodb.net:27017,ac-example-shard-00-02.example.mongodb.net:27017/ilmworld?ssl=true&replicaSet=atlas-example-shard-0&authSource=admin
MONGODB_DB=ilmworld

# Admin studio. Use a long random AUTH_SECRET in production.
ADMIN_EMAIL=admin@ilmworldacademy.com
ADMIN_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-string

# Public site URL used for canonical links, Open Graph, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# TinyMCE cloud. Leave empty to use the self-hosted GPL editor copied to /tinymce.
NEXT_PUBLIC_TINYMCE_API_KEY=

# Cloudinary. Either CLOUDINARY_URL or the three separate variables.
# The cloud name is public; do not commit the API secret.
CLOUDINARY_CLOUD_NAME=hbrxiqcq
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@hbrxiqcq
